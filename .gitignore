# Local tooling scratch, never part of the project itself.
.claude/

# Local build output. dist/ holds the locally-built test APKs used for
# on-device testing; they are large binaries regenerated by every build, so
# they stay on the dev machine rather than in the repo.
dist/
*.log

# Test scaffolding kept local rather than published: the unit suite plus any
# throwaway harnesses written to probe ROM layouts while reverse-engineering a
# new game profile. CI only runs assembleDebug, so nothing here is needed to
# build or verify the app from a clean checkout.
app/src/test/
app/src/androidTest/
